<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Malformed doc comments and unresolved crefs fail the build; missing ones don't, as QuantLib's coverage is partial. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Debugging: the PDB carries the source text, symbols ship as a symbol package, builds are deterministic.
         ContinuousIntegrationBuild is set only by release builds, in the environment (release.yml, and ci.yml's release
         mode): it records the source paths as /_/, which Source Link maps to the commit on GitHub. -->
    <EmbedAllSources>true</EmbedAllSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Each package's metadata; its description, tags and README are its project's. The assemblies' version is the
       major alone, kept for every 2.y release: bindings/surface.json names closed generic types by assembly-qualified
       names, which carry it (docs/bindings.md, "Versions"). -->
  <PropertyGroup>
    <Version>2.2</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <Authors>The nanoql Authors</Authors>
    <Copyright>Copyright 2026 The nanoql Authors</Copyright>
    <PackageProjectUrl>https://nanoql.org</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)\README.md')">README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/nanoql-dev/nanoql/blob/v$(Version)/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE;$(MSBuildThisFileDirectory)NOTICE;$(MSBuildThisFileDirectory)THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildProjectDirectory)\README.md')" />
  </ItemGroup>

  <!-- One type per file, the file named after its type: SA1402 and SA1649 only (.editorconfig). -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.3.82-beta" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="QuantLibVersion" Value="1.44" />
  </ItemGroup>
</Project>
