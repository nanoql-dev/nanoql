<!-- QLNet's vector generator (docs/porting-playbook.md §7.2): one console program on the QLNet 1.13.2 package, outside
     the solution, its restore locked to packages.lock.json. Each shim under tools/vectors/gen/qlnet/ builds it into a
     temporary folder and runs one subcommand, which writes one vector file. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QLNet" Version="[1.13.2]" />
  </ItemGroup>
</Project>
