<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NanoQL.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NQL0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <!-- The coverage gate's engine: Coverlet's Microsoft.Testing.Platform extension. -->
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NanoQL\NanoQL.csproj" />
  </ItemGroup>

  <!-- Ported tests keep QuantLib's type names (Real, Rate, Size, ...): the library's global aliases. -->
  <ItemGroup>
    <Compile Include="..\..\src\NanoQL\Types.cs" Link="Types.cs" />
  </ItemGroup>

  <!-- The committed vectors, read beside the test assembly. -->
  <ItemGroup>
    <None Include="..\vectors\**\*.json" Link="vectors\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
