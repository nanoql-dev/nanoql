<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NanoQL.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NQL0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <!-- The coverage gate's engine: Microsoft's code coverage for Microsoft.Testing.Platform, its settings in
         CodeCoverage.xml beside this file. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NanoQL\NanoQL.csproj" />
    <ProjectReference Include="..\..\src\NanoQL.Extensions\NanoQL.Extensions.csproj" />
  </ItemGroup>

  <!-- Ported tests keep QuantLib's type names (Real, Rate, Size, ...): the library's global aliases. -->
  <ItemGroup>
    <Compile Include="..\..\src\NanoQL\Types.cs" Link="Types.cs" />
  </ItemGroup>

  <!-- The committed vectors, read beside the test assembly. -->
  <ItemGroup>
    <None Include="..\vectors\**\*.json" Link="vectors\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The SOFR curve example's conventions file, which the example reads beside the test assembly. -->
  <ItemGroup>
    <None Update="Extensions\SofrCurveExample.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The FpML alias table the alias generator reads, which the aliases' tests check the shipped codes against. -->
  <ItemGroup>
    <None Include="..\..\tools\vectors\gen\conventions\fpml-aliases.toml" Link="conventions\fpml-aliases.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
