<!--
  An illustrative SOFR OIS convention, docs/conventions.md's example: SOFR swaps settling two days after the trade,
  paid annually two business days after each period ends on the US government bond calendar, the fixed leg on
  Actual/360. USGS and ACT/360 are FpML's codes, aliases of nanoql's UnitedStates.GovernmentBond and Actual360.
-->
<Conventions xmlns="https://nanoql.org/schemas/conventions">
  <OisConvention name="USD-SOFR">
    <Index>Sofr</Index>
    <SettlementDays>2</SettlementDays>
    <PaymentLag>2</PaymentLag>
    <PaymentFrequency>Annual</PaymentFrequency>
    <PaymentCalendar>USGS</PaymentCalendar>
    <FixedLegDayCounter>ACT/360</FixedLegDayCounter>
  </OisConvention>
</Conventions>
