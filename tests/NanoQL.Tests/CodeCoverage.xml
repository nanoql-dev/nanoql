<!-- The coverage gate's settings (docs/porting-playbook.md §8, G7): the library and its extensions are instrumented. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]NanoQL\.dll$</ModulePath>
        <ModulePath>.*[\\/]NanoQL\.Extensions\.dll$</ModulePath>
      </Include>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
