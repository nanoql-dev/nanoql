<Project Sdk="Microsoft.NET.Sdk">
  <!-- The native host (docs/bindings.md): the C ABI's runtime (handles, errors, strings, arrays, the fixed functions),
       published with Native AOT as one shared library, nanoql.dll, libnanoql.so or libnanoql.dylib. nanoql-bind writes
       the export shims for the assemblies it binds into obj/nanoql-bind/ and passes their folder as NanoQLShimsDir;
       NanoQLTestExports=true makes the test build (8-bit handle generations, the test types' functions). -->
  <PropertyGroup>
    <!-- What Directory.Build.props gives it in the repository, stated for the copy nanoql-bind writes outside it. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NanoQL.Native</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The library loads no ICU, so it runs where libicu is absent and its messages read the same in every locale. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The bindings export the experimental API, each declaration behind its language's opt-in. -->
    <NoWarn>$(NoWarn);NQL0001</NoWarn>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <DefineConstants Condition="'$(NanoQLTestExports)' == 'true'">$(DefineConstants);NANOQL_TEST_EXPORTS</DefineConstants>
  </PropertyGroup>

  <!-- nanoql's two assemblies: the repository's projects, or outside it the tool's own copies, whose folder nanoql-bind
       passes as NanoQLLibraryDir when it writes this project into a build's output. -->
  <ItemGroup Condition="'$(NanoQLLibraryDir)' == ''">
    <ProjectReference Include="..\NanoQL\NanoQL.csproj" />
    <ProjectReference Include="..\NanoQL.Extensions\NanoQL.Extensions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(NanoQLLibraryDir)' != ''">
    <Reference Include="NanoQL" HintPath="$(NanoQLLibraryDir)NanoQL.dll" />
    <Reference Include="NanoQL.Extensions" HintPath="$(NanoQLLibraryDir)NanoQL.Extensions.dll" />
  </ItemGroup>

  <!-- In the repository the tool, built first, writes the shims into obj/ before the compile, unless its build command
       already did; none of its files is copied into the host's output (Private). -->
  <ItemGroup Condition="'$(NanoQLLibraryDir)' == ''">
    <ProjectReference Include="..\NanoQL.Bind\NanoQL.Bind.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;NativeLib" />
    <ProjectReference Include="..\..\bindings\NanoQL.Bind.TestTypes\NanoQL.Bind.TestTypes.csproj" Condition="'$(NanoQLTestExports)' == 'true'" />
  </ItemGroup>

  <PropertyGroup>
    <NanoQLTestSuffix Condition="'$(NanoQLTestExports)' == 'true'">-test</NanoQLTestSuffix>
    <NanoQLTestArgument Condition="'$(NanoQLTestExports)' == 'true'"> --test-exports</NanoQLTestArgument>
    <NanoQLShimsDir Condition="'$(NanoQLShimsDir)' == ''">$(MSBuildProjectDirectory)/obj/nanoql-bind/$(Configuration)$(NanoQLTestSuffix)/</NanoQLShimsDir>
  </PropertyGroup>

  <Target Name="NanoQLShims" BeforeTargets="CoreCompile">
    <Exec Condition="'$(NanoQLGenerateShims)' != 'false'" WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="dotnet &quot;$(MSBuildProjectDirectory)/../NanoQL.Bind/bin/$(Configuration)/net10.0/NanoQL.Bind.dll&quot; shims --out &quot;$(NanoQLShimsDir)&quot;$(NanoQLTestArgument)" />
    <ItemGroup>
      <Compile Include="$([MSBuild]::EnsureTrailingSlash('$(NanoQLShimsDir)'))*.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Assemblies built on nanoql, by path: a user's, or the test build's own. -->
  <ItemGroup Condition="'$(NanoQLAssemblies)' != ''">
    <Reference Include="$(NanoQLAssemblies)" />
  </ItemGroup>

  <!-- The native file's name: nanoql, set before ILC links it; the import library and the symbols follow it. ILC gives
       a shared library no lib prefix, so it's set here, with the name a program linked to it records: Linux's soname,
       and macOS's install name, which ILC reads before this target runs. -->
  <PropertyGroup>
    <SharedLibraryInstallName>@rpath/libnanoql.dylib</SharedLibraryInstallName>
  </PropertyGroup>

  <Target Name="NanoQLNativeName" BeforeTargets="LinkNative">
    <PropertyGroup>
      <NanoQLNativePrefix Condition="'$(NativeBinaryExt)' != '.dll'">lib</NanoQLNativePrefix>
      <NativeBinary>$(NativeOutputPath)$(NanoQLNativePrefix)nanoql$(NativeBinaryExt)</NativeBinary>
    </PropertyGroup>
    <ItemGroup>
      <LinkerArg Include="-Wl,-soname,libnanoql.so" Condition="'$(NativeBinaryExt)' == '.so'" />
    </ItemGroup>
  </Target>

  <Target Name="NanoQLNativeFiles" AfterTargets="Publish">
    <ItemGroup>
      <_NanoQLNative Include="$(NativeOutputPath)nanoql.lib;$(NativeOutputPath)nanoql.pdb;$(NativeOutputPath)$(NanoQLNativePrefix)nanoql$(NativeBinaryExt).dbg" />
    </ItemGroup>
    <Copy SourceFiles="@(_NanoQLNative)" DestinationFolder="$(PublishDir)" Condition="Exists('%(Identity)')" />
    <Exec Command="cp -R &quot;$(NativeOutputPath)$(NanoQLNativePrefix)nanoql$(NativeBinaryExt).dSYM&quot; &quot;$(PublishDir)&quot;"
          Condition="Exists('$(NativeOutputPath)$(NanoQLNativePrefix)nanoql$(NativeBinaryExt).dSYM')" />
  </Target>
</Project>
