<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Quantitative finance for .NET, stateless by design: calendars, curves, instruments, pricing engines and models, each a plain function of its inputs, with market conventions as data.</Description>
    <PackageTags>finance;quantitative-finance;derivatives;pricing;fixed-income;yield-curve;options;risk</PackageTags>
    <RootNamespace>NanoQL</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- NanoQL's own code may use its experimental types (NQL0001); consumers still get the diagnostic. -->
    <NoWarn>$(NoWarn);NQL0001</NoWarn>
  </PropertyGroup>

  <!-- QuantLib's data tables, generated by tools/tables/ and read once, at first use, under these fixed names. -->
  <ItemGroup>
    <EmbeddedResource Include="Numerics\RandomNumbers\PrimitivePolynomials.bin" LogicalName="NanoQL.Numerics.RandomNumbers.PrimitivePolynomials.bin" />
    <EmbeddedResource Include="Numerics\RandomNumbers\LatticeRules\LatticeRules.bin" LogicalName="NanoQL.Numerics.RandomNumbers.LatticeRules.LatticeRules.bin" />
    <EmbeddedResource Include="Experimental\Volatility\NoArbSabrAbsProbs.bin" LogicalName="NanoQL.Experimental.Volatility.NoArbSabrAbsProbs.bin" />
    <EmbeddedResource Include="PricingEngines\Vanilla\ExponentialFittingHestonEngine\ExponentialFittingHestonEngineValues.bin" LogicalName="NanoQL.PricingEngines.Vanilla.ExponentialFittingHestonEngine.ExponentialFittingHestonEngineValues.bin" />
    <EmbeddedResource Include="Numerics\RandomNumbers\SobolRsg\AltPrimitivePolynomials.bin" LogicalName="NanoQL.Numerics.RandomNumbers.SobolRsg.AltPrimitivePolynomials.bin" />
    <EmbeddedResource Include="Numerics\RandomNumbers\SobolRsg\SLinitializers.bin" LogicalName="NanoQL.Numerics.RandomNumbers.SobolRsg.SLinitializers.bin" />
    <EmbeddedResource Include="Numerics\RandomNumbers\SobolRsg\Initializers.bin" LogicalName="NanoQL.Numerics.RandomNumbers.SobolRsg.Initializers.bin" />
    <EmbeddedResource Include="Numerics\RandomNumbers\SobolRsg\Linitializers.bin" LogicalName="NanoQL.Numerics.RandomNumbers.SobolRsg.Linitializers.bin" />
    <EmbeddedResource Include="Numerics\RandomNumbers\SobolRsg\Kuoinitializers.bin" LogicalName="NanoQL.Numerics.RandomNumbers.SobolRsg.Kuoinitializers.bin" />
    <EmbeddedResource Include="Numerics\RandomNumbers\SobolRsg\Kuo2initializers.bin" LogicalName="NanoQL.Numerics.RandomNumbers.SobolRsg.Kuo2initializers.bin" />
    <EmbeddedResource Include="Numerics\RandomNumbers\SobolRsg\Kuo3initializers.bin" LogicalName="NanoQL.Numerics.RandomNumbers.SobolRsg.Kuo3initializers.bin" />
    <EmbeddedResource Include="Numerics\RandomNumbers\SobolRsg\JoeKuoD5initializers.bin" LogicalName="NanoQL.Numerics.RandomNumbers.SobolRsg.JoeKuoD5initializers.bin" />
    <EmbeddedResource Include="Numerics\RandomNumbers\SobolRsg\JoeKuoD6initializers.bin" LogicalName="NanoQL.Numerics.RandomNumbers.SobolRsg.JoeKuoD6initializers.bin" />
    <EmbeddedResource Include="Numerics\RandomNumbers\SobolRsg\JoeKuoD7initializers.bin" LogicalName="NanoQL.Numerics.RandomNumbers.SobolRsg.JoeKuoD7initializers.bin" />
  </ItemGroup>
</Project>
