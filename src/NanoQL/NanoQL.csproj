<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>NanoQL</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- NanoQL's own code may use its experimental types (NQL0001); consumers still get the diagnostic. -->
    <NoWarn>$(NoWarn);NQL0001</NoWarn>
  </PropertyGroup>
</Project>
