<Project Sdk="Microsoft.NET.Sdk">
  <!-- nanoql-bind: the bindings' generator and native build, a .NET tool (docs/bindings.md). It reads built
       assemblies' metadata without running them; nanoql's own two are copied beside it and are its default input. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NanoQL.Bind</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nanoql-bind</ToolCommandName>
    <PackageId>NanoQL.Bind</PackageId>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NanoQL.Bind.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The C++ layer's hand-written part, which nanoql.hpp carries after its enums. -->
    <EmbeddedResource Include="..\..\bindings\cpp\runtime.hpp" LogicalName="NanoQL.Bind.runtime.hpp" />
    <!-- nanoql's Excel list, and the notices a user's Excel build carries beside its add-in. -->
    <EmbeddedResource Include="..\..\bindings\excel\list.json" LogicalName="NanoQL.Bind.excel-list.json" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="NanoQL.Bind.notices.LICENSE" />
    <EmbeddedResource Include="..\..\NOTICE" LogicalName="NanoQL.Bind.notices.NOTICE" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES.md" LogicalName="NanoQL.Bind.notices.THIRD_PARTY_NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NanoQL\NanoQL.csproj" />
    <ProjectReference Include="..\NanoQL.Extensions\NanoQL.Extensions.csproj" />
  </ItemGroup>
</Project>
