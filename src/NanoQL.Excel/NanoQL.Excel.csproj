<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Excel add-in's runtime (docs/excel.md), packed as NanoQL.Excel: the handles and their store, the conversions
       between Excel's values and nanoql's, the errors, the settings file, the bound engine and the add-in's own nqlxl
       functions. nanoql-bind generates an add-in's worksheet functions into a project that references this package;
       Windows only, so it builds in the Excel solution (bindings/excel/NanoQL.Excel.slnx), not in NanoQL.slnx. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NanoQL.Excel</RootNamespace>
    <PackageId>NanoQL.Excel</PackageId>
    <Description>The runtime of nanoql's Excel add-in: handles, conversions, errors and settings for the worksheet functions nanoql-bind generates.</Description>
    <PackageTags>finance;quantitative-finance;excel;excel-dna</PackageTags>
    <!-- The add-in exposes the experimental API in its experimental build, behind its opt-in. -->
    <NoWarn>$(NoWarn);NQL0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.Integration" Version="1.9.0" />
  </ItemGroup>

  <!-- nanoql's assemblies aren't the package's dependencies: an add-in binds them by path, the version its tool carries
       here, so a generated project never restores another nanoql. -->
  <ItemGroup>
    <ProjectReference Include="..\NanoQL\NanoQL.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\NanoQL.Extensions\NanoQL.Extensions.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NanoQL.Excel.Tests" />
    <InternalsVisibleTo Include="NanoQL.Excel.Replay" />
  </ItemGroup>
</Project>
