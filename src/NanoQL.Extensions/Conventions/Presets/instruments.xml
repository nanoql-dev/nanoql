  <OisConvention name="MakeOIS">
    <SettlementDays>2</SettlementDays>
    <PaymentLag>0</PaymentLag>
    <PaymentConvention>Following</PaymentConvention>
    <PaymentFrequency>Annual</PaymentFrequency>
    <FixedLegFrequency>Annual</FixedLegFrequency>
    <FixedLegConvention>ModifiedFollowing</FixedLegConvention>
    <FixedLegTerminationDateConvention>ModifiedFollowing</FixedLegTerminationDateConvention>
    <FixedLegRule>Backward</FixedLegRule>
    <OvernightLegConvention>ModifiedFollowing</OvernightLegConvention>
    <OvernightLegTerminationDateConvention>ModifiedFollowing</OvernightLegTerminationDateConvention>
    <OvernightLegRule>Backward</OvernightLegRule>
    <TelescopicValueDates>false</TelescopicValueDates>
    <Averaging>Compound</Averaging>
    <LockoutDays>0</LockoutDays>
    <ObservationShift>false</ObservationShift>
  </OisConvention>
  <OisConvention name="MakeOIS.Corra" base="MakeOIS">
    <SettlementDays>1</SettlementDays>
  </OisConvention>
  <OisConvention name="MakeOIS.Sonia" base="MakeOIS">
    <SettlementDays>0</SettlementDays>
  </OisConvention>
  <CdsConvention name="MakeCreditDefaultSwap">
    <Calendar>WeekendsOnly</Calendar>
    <CouponFrequency>Quarterly</CouponFrequency>
    <PaymentConvention>Following</PaymentConvention>
    <Rule>CDS</Rule>
    <DayCounter>Actual360</DayCounter>
    <LastPeriodDayCounter>Actual360.IncludeLastDay</LastPeriodDayCounter>
    <SettlesAccrual>true</SettlesAccrual>
    <PaysAtDefaultTime>true</PaysAtDefaultTime>
    <RebatesAccrual>true</RebatesAccrual>
    <CashSettlementDays>3</CashSettlementDays>
  </CdsConvention>
  <CapFloorConvention name="MakeCapFloor">
    <FirstCapletExcluded>true</FirstCapletExcluded>
  </CapFloorConvention>
  <SwaptionConvention name="MakeSwaption">
    <SettlementType>Physical</SettlementType>
    <SettlementMethod>PhysicalOTC</SettlementMethod>
    <OptionConvention>ModifiedFollowing</OptionConvention>
  </SwaptionConvention>
  <MultipleResetsSwapConvention name="MakeMultipleResetsSwap">
    <FixedLegConvention>ModifiedFollowing</FixedLegConvention>
    <Averaging>Compound</Averaging>
  </MultipleResetsSwapConvention>
  <BondConvention name="FixedRateBond">
    <PaymentConvention>Following</PaymentConvention>
    <Redemption>100</Redemption>
    <ExCouponConvention>Unadjusted</ExCouponConvention>
    <ExCouponEndOfMonth>false</ExCouponEndOfMonth>
    <PriceType>Clean</PriceType>
  </BondConvention>
</Conventions>
