<Conventions xmlns="https://nanoql.net/schemas/conventions">
  <SwapConvention name="MakeVanillaSwap.AUD">
    <FixedLegTenor>3M</FixedLegTenor>
    <FixedLegTenorThreshold>
      <Comparison>AtLeast</Comparison>
      <SwapTenor>4Y</SwapTenor>
      <FixedLegTenor>6M</FixedLegTenor>
    </FixedLegTenorThreshold>
    <FixedLegConvention>ModifiedFollowing</FixedLegConvention>
    <FixedLegTerminationDateConvention>ModifiedFollowing</FixedLegTerminationDateConvention>
    <FixedLegRule>Backward</FixedLegRule>
    <FixedLegEndOfMonth>false</FixedLegEndOfMonth>
    <FixedLegDayCounter>Actual365Fixed</FixedLegDayCounter>
    <FloatingLegRule>Backward</FloatingLegRule>
    <FloatingLegEndOfMonth>false</FloatingLegEndOfMonth>
  </SwapConvention>
