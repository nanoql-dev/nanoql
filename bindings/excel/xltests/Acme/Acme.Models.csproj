<Project Sdk="Microsoft.NET.Sdk">
  <!-- A user's assembly built on nanoql (XLR8): a curve of its own, which run.py builds into an add-in beside nanoql's
       functions under the prefix acme, as a user would with `nanoql-bind excel build`. -->
  <PropertyGroup>
    <RootNamespace>Acme.Models</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\NanoQL\NanoQL.csproj" />
    <ProjectReference Include="..\..\..\..\src\NanoQL.Extensions\NanoQL.Extensions.csproj" />
  </ItemGroup>
</Project>
