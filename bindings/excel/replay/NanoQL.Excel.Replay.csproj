<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Excel replayer (docs/excel.md): the vector suite's recorded trace through a build's generated worksheet
       functions, outside Excel, each result against C#'s. The build's assembly is loaded by path from an
       `nanoql-bind excel build` folder; the runtime is this solution's. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NanoQL.Excel.Replay</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NQL0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\NanoQL.Excel\NanoQL.Excel.csproj" />
    <ProjectReference Include="..\..\..\src\NanoQL\NanoQL.csproj" />
    <ProjectReference Include="..\..\..\src\NanoQL.Extensions\NanoQL.Extensions.csproj" />
  </ItemGroup>
</Project>
