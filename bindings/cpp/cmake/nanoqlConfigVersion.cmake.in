#
# The package's version, by CMake's SameMajorVersion rule: this 2.y package serves a request for 2.x at most 2.y, or a
# range whose ends both lie in major 2 and which holds 2.y. A minor release adds to the stable API and removes only
# what was deprecated two releases and a year before (docs/bindings.md, "Versions"). A 32-bit build is refused.
set(PACKAGE_VERSION "@VERSION@")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
set(PACKAGE_VERSION_EXACT FALSE)
if(CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  set(PACKAGE_VERSION_UNSUITABLE TRUE)
  set(PACKAGE_VERSION "${PACKAGE_VERSION} (64-bit)")
  return()
endif()
if(NOT PACKAGE_FIND_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  return()
endif()
string(REGEX MATCH "^[0-9]+" _nanoql_major "${PACKAGE_VERSION}")
math(EXPR _nanoql_next "${_nanoql_major} + 1")
if(PACKAGE_FIND_VERSION_RANGE)
  # Both ends in this major: an included upper end of this major, or an excluded one at most the next major's start.
  set(_nanoql_ends FALSE)
  if(PACKAGE_FIND_VERSION_MIN_MAJOR STREQUAL _nanoql_major)
    if(PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "INCLUDE")
      if(PACKAGE_FIND_VERSION_MAX_MAJOR STREQUAL _nanoql_major)
        set(_nanoql_ends TRUE)
      endif()
    elseif(PACKAGE_FIND_VERSION_MAX VERSION_LESS_EQUAL _nanoql_next)
      set(_nanoql_ends TRUE)
    endif()
  endif()
  set(_nanoql_inside FALSE)
  if(NOT PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION_MIN)
    if(PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "INCLUDE" AND PACKAGE_VERSION VERSION_LESS_EQUAL PACKAGE_FIND_VERSION_MAX)
      set(_nanoql_inside TRUE)
    elseif(PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "EXCLUDE" AND PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION_MAX)
      set(_nanoql_inside TRUE)
    endif()
  endif()
  if(_nanoql_ends AND _nanoql_inside)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
  endif()
  unset(_nanoql_ends)
  unset(_nanoql_inside)
elseif(PACKAGE_FIND_VERSION_MAJOR STREQUAL _nanoql_major AND NOT PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
endif()
unset(_nanoql_major)
unset(_nanoql_next)
